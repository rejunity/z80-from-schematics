# IM 2 INT acceptance. The CPU reads {I, vector} from memory to find the
# interrupt-service-routine address, then jumps there. I = 0x80, and every
# harness puts 00 on the bus during INTA (perfectz80_runner sets it; the
# others drive 00 whenever nothing is read), so the table read is at
# 0x8000 / 0x8001 and the ISR at 0x9000. The address is compared in every
# phase, so a wrong {I, vector} shows as a difference.
@0000
ED 5E              # IM 2
3E 80              # LD A,0x80
ED 47              # LD I,A         (now I = 0x80)
FB                 # EI
00 00 00 00 00     # NOPs (loop)
C3 07 00           # JP 0x0007      (back into the NOP loop)
@0066
76                 # HALT (NMI vector — present so an accidental NMI doesn't crash)
@8000
00 90              # ISR pointer at vector=0 (lo, hi) = 0x9000
@9000
76                 # HALT at the ISR (terminate trace deterministically)
