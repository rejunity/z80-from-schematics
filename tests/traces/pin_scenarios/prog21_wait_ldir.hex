# WAIT on the T2 sample of LDIR's write M-cycle -- the T-state on whose
# edge the RTL's incrementer does BC-1. Two iterations (BC=2), then the
# final BC / DE / HL are pushed so the bus shows them.
@0000
31 00 A0           # LD SP,0xA000
21 00 80           # LD HL,0x8000
11 00 90           # LD DE,0x9000
01 02 00           # LD BC,0x0002
ED B0              # LDIR
C5 D5 E5           # PUSH BC / PUSH DE / PUSH HL
76                 # HALT
@8000
5A A5
