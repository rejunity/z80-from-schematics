# EI's one-instruction delay window. EI enables IFF1/IFF2 effective AFTER
# the NEXT instruction completes. INT goes low during EI's own M1 and
# stays low: acceptance waits until the NOP after EI has finished,
# observable as the INTA M-cycle starting after that NOP, not at EI's end.
@0000
ED 56              # IM 1
FB                 # EI         (during this and the next NOP, INT is masked)
00                 # NOP        (this is the EI shadow window)
00                 # NOP        (INT may now be accepted)
C3 03 00           # JP 0x0003  (loop in NOPs)
@0038
76                 # HALT (IM1 vector)
